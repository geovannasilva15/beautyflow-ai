APP_ENV=development
DATABASE_URL=sqlite:///beautyflow_ai.db
API_URL=http://127.0.0.1:8000/api
BUSINESS_TIMEZONE=America/Sao_Paulo
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=19
SLOT_INTERVAL_MINUTES=30

# Somente na API. Chaves opcionais para o piloto.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WHATSAPP_TEST_MODE=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEST_RECIPIENTS=

# Exclusivo de bancos fictícios locais. Mantido desligado por padrão.
ENABLE_DEMO_SIMULATION=false
